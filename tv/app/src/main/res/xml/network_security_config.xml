<?xml version="1.0" encoding="utf-8"?>
<!-- Many family servers are reached as http://<ip>:<port> without a certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Older TVs (e.g. Mi TV 4) lack ISRG Root X1, the root behind Let's Encrypt. -->
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
